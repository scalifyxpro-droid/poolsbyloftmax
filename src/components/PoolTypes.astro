---
const types = [
  { image: '/images/gallery/project-8.jpeg', alt: 'Infinity-edge pool with wading shelf built by Pools by Loftmax', title: 'Infinity Pool', text: 'The far edge disappears rather than stops, so the pool reads as one continuous sheet of water right up to the garden wall.' },
  { image: '/images/gallery/project-1.jpeg', alt: 'Raised spa with overflow edge built by Pools by Loftmax', title: 'Overflow Pool', text: "Water spills evenly over a raised edge into a hidden catch channel — dramatic to look at, and it doubles as a natural skimmer." },
  { image: '/images/gallery/project-7.jpeg', alt: 'Raised-deck skimmer pool built by Pools by Loftmax', title: 'Skimmer Pool', text: "The standard, reliable build — wall-mounted skimmers pull surface debris in, keeping running costs and upkeep low." },
];
---
<section class="pool-types" id="pooltypes">
  <div class="container">
    <div class="section-head light">
      <span class="eyebrow">Explore</span>
      <h2>Pool Types We Build</h2>
      <p>Every plot is different, so the right build depends on your space and how you'll use it.</p>
    </div>
    <div class="pool-types-grid">
      {types.map((type) => (
        <div class="pool-type-card">
          <img src={type.image} alt={type.alt} />
          <div class="pool-type-body">
            <h3>{type.title}</h3>
            <p>{type.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
