---
const services = [
  {
    title: 'Design & Construction',
    text: "We plan around your plot, your budget and how you'll actually use the pool, then build it start to finish with our own crew.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 6 L15 22 M24 6 L33 22 M24 6 L24 13"/>
      <circle cx="24" cy="31" r="9" stroke-dasharray="3 3"/>
      <path d="M15 22 L19.5 26.5 M33 22 L28.5 26.5"/>
    </svg>`,
  },
  {
    title: 'Maintenance',
    text: "Dubai heat is hard on pools. We run regular cleaning and equipment checks so problems get caught before they become repairs.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8c0 3-2.2 4.6-2.2 8 0 3 2 4.5 2 7.4 0 5.6-4.4 9.4-4.4 9.4"/>
      <path d="M28 6c2.5 5-1 7-1 12.4 0 5.2 4.4 6.6 4.4 13.2 0 4.6-3.6 8-3.6 8"/>
      <path d="M13.5 41h21" stroke-linecap="round"/>
    </svg>`,
  },
  {
    title: 'Renovation & Restoration',
    text: "Cracked tiling, a failing liner, a pool that's simply dated — we diagnose the real cause first, then rebuild it properly.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M34 14a13 13 0 1 0 2.6 10.4"/>
      <path d="M36.5 6.5 L34 14 L26.5 12"/>
      <path d="M20 24 l4 4 8-8" />
    </svg>`,
  },
  {
    title: 'Leak Detection & Troubleshooting',
    text: "Losing water, tripping pumps, a pool that never quite balances — we track down the actual fault instead of guessing at parts.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 6c-5 7-9 11.8-9 17a9 9 0 0 0 18 0c0-5.2-4-10-9-17Z"/>
      <circle cx="30" cy="30" r="9"/>
      <path d="M36.5 36.5 42 42"/>
    </svg>`,
  },
  {
    title: 'Pool Consultancy',
    text: "Buying a villa with an existing pool, or planning one with your architect? We'll review the plans or the pool before you commit.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 8h18l6 6v26a2 2 0 0 1-2 2H13a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2Z"/>
      <path d="M31 8v6h6"/>
      <path d="M16 24h11 M16 30h11 M16 18h7"/>
    </svg>`,
  },
  {
    title: 'Safety & Fencing',
    text: "Custom-built glass and metal fencing that keeps kids and pets safe without blocking the view of the pool.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 6 L38 11 v10 c0 9-6 15.5-14 19-8-3.5-14-10-14-19V11 Z"/>
      <path d="M18 24 l4.5 4.5 L31 19"/>
    </svg>`,
  },
  {
    title: 'Water Testing',
    text: "Chlorine, pH, salinity — we test on site and adjust dosing so the water stays safe without over-chemicalling it.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6h8 M22 6v16.5L14.5 34a4 4 0 0 0 3.4 6.2h12.2a4 4 0 0 0 3.4-6.2L26 22.5V6"/>
      <path d="M17.5 30h13" />
      <circle cx="24" cy="34" r="1.6" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  {
    title: 'Landscaping',
    text: "Decking, planting and outdoor seating laid out to work with the pool, so the whole garden reads as one finished space.",
    icon: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 41V21"/>
      <path d="M24 24c0-8-7-9-13-9 0 9 5 13 13 13"/>
      <path d="M24 19c0-6.5 5.5-8 11-8 0 7.5-4.5 11.5-11 11.5"/>
      <path d="M14 41h20"/>
    </svg>`,
  },
];
---
<section class="services" id="services">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What We Do</span>
      <h2>Our Services</h2>
      <p>One team, start to finish — from the first sketch to the day-to-day upkeep.</p>
    </div>
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <div class="service-icon" set:html={service.icon} />
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
